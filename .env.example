# Copy this file to .env. Never commit the resulting .env file.
# Generate strong values with: openssl rand -hex 32
APP_ENV=production
POSTGRES_DB=hawk_scanner
POSTGRES_USER=hawk
POSTGRES_PASSWORD=replace-with-a-unique-postgresql-password
DATABASE_URL=postgresql://hawk:replace-with-a-unique-postgresql-password@postgres:5432/hawk_scanner?schema=public
REDIS_URL=redis://redis:6379/0

# Required application secrets. Both values must be distinct, random and at least 32 characters.
JWT_SECRET=replace-with-a-long-random-jwt-signing-secret-at-least-32-characters
INTERNAL_SCHEDULER_TOKEN=replace-with-a-separate-long-random-scheduler-token-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30
API_RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# The account registered with this exact email becomes the initial SUPER_ADMIN. Remove after bootstrap.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Scanner behavior. The strict default prevents incomplete third-party data from producing a ranking.
SCAN_INTERVAL_MINUTES=10
HAWK_ALERT_THRESHOLD=85
HAWK_MODEL_VERSION=hawk-score-v1
REQUIRE_ALL_DATA_SOURCES=true
ML_TRAIN_HOUR_UTC=0
ML_ARTIFACT_DIR=/var/lib/hawk-models
COINGECKO_CATALOG_PAGES=10
CATALOG_REFRESH_SECONDS=86400

# Notification destinations (optional, but each configured channel is delivered and audited).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# Mandatory market and on-chain data providers. Populate every value before enabling strict scans.
COINGECKO_API_KEY=
COINGLASS_API_KEY=
DEFILLAMA_API_KEY=
BITQUERY_API_KEY=
COVALENT_API_KEY=
ALCHEMY_API_KEY=
MORALIS_API_KEY=
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=
SOLSCAN_API_KEY=
